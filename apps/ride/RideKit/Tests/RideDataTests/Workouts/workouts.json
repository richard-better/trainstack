  },
  {
    "name": "A cycling workout with a distance step",
    "workout": {
      "name": "Ten kilometres steady",
      "sport": "cycling",
      "steps": [
        {
          "type": "step",
          "duration": { "type": "time", "seconds": 300 },
          "target": {
            "type": "power",
            "unit": "ftp",
            "level": { "kind": "constant", "value": 0.6 }
          }
        },
        {
          "type": "step",
