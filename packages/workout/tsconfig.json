{
  "extends": "@trainstack/config/tsconfig.base.json",
  "references": [
    {
      "path": "../fit"
    },
    {
      "path": "../zones"
    }
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
