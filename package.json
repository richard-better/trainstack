{
  "name": "trainstack",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "hosted/apps/*",
      "packages/*",
      "hosted/infra"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^26.6.6",
      "varlock": "1.24.0",
      "@cloudflare/workers-types": "^5.20261103.1",
      "@orpc/server": "^1.16.1",
      "@orpc/contract": "^1.16.1",
      "@orpc/openapi": "^1.16.1",
      "@orpc/json-schema": "^1.16.1",
      "@orpc/zod": "^1.16.1",
      "better-auth": "1.7.15",
      "evlog": "^2.34.0",
      "@orpc/client": "^1.16.1",
      "drizzle-orm": "1.0.0-rc.5",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "vite-plus": "1.4.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "dev:account": "node scripts/dev-account.mjs",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "test": "node --test tests/*.test.mjs packages/*/test/*.test.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "db:generate": "vp run --filter @trainstack/hosted-api db:generate",
    "deploy": "vp run --filter @trainstack/hosted-infra deploy",
    "deploy:production": "bun run --cwd hosted/infra deploy --stage production",
    "plan:production": "bun run --cwd hosted/infra plan --stage production",
    "destroy": "vp run --filter @trainstack/hosted-infra destroy",
    "env:generate": "varlock codegen --path ./hosted/apps/marketing/ && varlock codegen --path ./hosted/apps/api/ && varlock codegen --path ./hosted/apps/api/db/",
    "postinstall": "varlock codegen --path ./hosted/apps/marketing/ && varlock codegen --path ./hosted/apps/api/ && varlock codegen --path ./hosted/apps/api/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@orpc/client": "catalog:",
    "@trainstack/config": "workspace:*",
    "@types/node": "catalog:",
    "ical.js": "2.2.1",
    "miniflare": "4.20260730.0",
    "rolldown": "1.2.16",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
