# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Optional until the Strava application is registered.
# @public @required=false @type=string(minLength=1)
STRAVA_CLIENT_ID=

# @required=false @type=string(minLength=1)
STRAVA_CLIENT_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# The Sign in with Apple key for Apple's web flow. Optional: without it, only the app's native
# Sign in with Apple works.
# @required=false @sensitive=false @type=string(minLength=1)
APPLE_SIGN_IN_KEY_ID=

# The same key's .p8 file contents.
# @required=false @type=string(minLength=1)
APPLE_SIGN_IN_PRIVATE_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=
