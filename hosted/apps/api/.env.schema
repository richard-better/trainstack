# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Optional until the Strava application is registered.
# @public @required=false @type=string(minLength=1)
STRAVA_CLIENT_ID=

# @required=false @type=string(minLength=1)
STRAVA_CLIENT_SECRET=

# The kes-agent GitHub account's token for filing Ride feedback as issues. Optional: without it,
# feedback answers 503 feedback_not_configured.
# @required=false @type=string(minLength=1)
GITHUB_FEEDBACK_TOKEN=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=
