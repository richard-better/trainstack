{
  "name": "@trainstack/hosted-api",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../../packages/contract ../../../packages/zones ../../../packages/workout ../../../packages/logbook && vp pack",
    "check-types": "tsc -b ../../../packages/contract ../../../packages/zones ../../../packages/fit ../../../packages/activity-file ../../../packages/workout ../../../packages/analysis ../../../packages/logbook ../../../packages/readiness && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile api",
    "env:generate": "varlock codegen",
    "db:generate": "cd db && drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/core": "1.7.15",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@libsql/client": "0.18.0",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@trainstack/activity-file": "workspace:*",
    "@trainstack/analysis": "workspace:*",
    "@trainstack/contract": "workspace:*",
    "@trainstack/fit": "workspace:*",
    "@trainstack/logbook": "workspace:*",
    "@trainstack/readiness": "workspace:*",
    "@trainstack/workout": "workspace:*",
    "@trainstack/zones": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.16",
    "jose": "6.2.15",
    "libsql": "0.5.29",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@trainstack/config": "workspace:*",
    "@trainstack/hosted-infra": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "catalog:"
  }
}
