---
export type InstallTab = "macos" | "ios";

export type Platform = {
  name: string;
  body: string;
  action: { label: string; tab: InstallTab } | { note: string };
};

interface Props {
  platform: Platform;
}

const { platform } = Astro.props;
---

<h3 class="m-0 mt-5 font-geist-mono text-[15px] font-medium tracking-[-0.01em]">{platform.name}</h3>
<p class="m-0 mt-2 flex-1 text-[14px] leading-[1.55] text-pretty text-[#8e9096]">{platform.body}</p>
<div class="mt-5">
  {
    "label" in platform.action ? (
      <a
        href="#install"
        data-install-tab={platform.action.tab}
        class="inline-flex h-9 items-center gap-2 rounded-[8px] bg-ts-mist px-3.5 text-[13px] font-medium text-ts-night transition-opacity hover:opacity-80"
      >
        {platform.action.label}
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14m-6-6 6 6 6-6" />
        </svg>
      </a>
    ) : (
      <span class="inline-flex h-9 items-center rounded-[8px] border border-[#2a2b2f] px-3.5 text-[13px] text-[#8e9096]">
        {platform.action.note}
      </span>
    )
  }
</div>
