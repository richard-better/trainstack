---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="LLM usage" active="llm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-xl font-semibold text-white">LLM usage &amp; cost</h1>
    <div class="flex items-center gap-2">
      <label class="text-xs text-neutral-500" for="window">Window</label>
      <select
        id="window"
        class="rounded-md border border-neutral-800 bg-neutral-900 px-2 py-1 text-sm"
      >
        <option value="1">24 hours</option>
        <option value="7" selected>7 days</option>
        <option value="30">30 days</option>
        <option value="90">90 days</option>
      </select>
    </div>
  </div>
  <p id="llm-scope" class="mb-4 text-sm text-neutral-500"></p>

  <div id="llm-totals" class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-5"></div>
  <div id="llm-by-endpoint" class="mb-8"></div>

  <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Recent calls</h2>
  <div id="llm-recent"></div>
</AdminLayout>

<script>
  import { ensureAdmin, table, link, badge, mount, h, fmtDateTime, fmtCost, fmtInt } from "../../lib/admin";
  import { orpc } from "../../lib/orpc";

  const me = await ensureAdmin();
  if (me) {
    const params = new URLSearchParams(window.location.search);
    const userFilter = params.get("user") ?? undefined;

    const windowSel = document.getElementById("window") as HTMLSelectElement;
    const scope = document.getElementById("llm-scope")!;
    const totalsEl = document.getElementById("llm-totals")!;
    const byEndpointEl = document.getElementById("llm-by-endpoint")!;
    const recentEl = document.getElementById("llm-recent")!;

    function stat(label: string, value: string): HTMLElement {
      return h(
        "div",
        { class: "rounded-lg border border-neutral-800 bg-neutral-900 p-3" },
        h("div", { class: "text-xs text-neutral-500" }, label),
        h("div", { class: "mt-1 text-lg font-semibold text-white" }, value),
      );
    }

    async function load() {
      const sinceDays = Number(windowSel.value);
      scope.textContent = userFilter
        ? `Filtered to user ${userFilter} · last ${sinceDays} day(s)`
        : `All users · last ${sinceDays} day(s)`;

      try {
        const [stats, recent] = await Promise.all([
          orpc.admin.llmStats({ userId: userFilter, sinceDays }),
          orpc.admin.listLlmCalls({ userId: userFilter, limit: 100 }),
        ]);

        mount(
          totalsEl,
          stat("Calls", fmtInt(stats.totals.calls)),
          stat("Errors", fmtInt(stats.totals.errors)),
          stat("Cost", fmtCost(stats.totals.costUsd)),
          stat("Input tokens", fmtInt(stats.totals.inputTokens)),
          stat("Output tokens", fmtInt(stats.totals.outputTokens)),
        );

        mount(
          byEndpointEl,
          table(
            ["Endpoint", "Calls", "Input tok", "Output tok", "Cost", "Avg latency"],
            stats.byEndpoint.map((e) => [
              e.endpoint,
              fmtInt(e.calls),
              fmtInt(e.inputTokens),
              fmtInt(e.outputTokens),
              fmtCost(e.costUsd),
              `${fmtInt(e.avgLatencyMs)} ms`,
            ]),
          ),
        );

        mount(
          recentEl,
          table(
            ["When", "User", "Endpoint", "Model", "Status", "In/Out", "Cost", "Latency"],
            recent.calls.map((c) => [
              fmtDateTime(c.createdAt),
              c.userId ? link(`/admin/users/${c.userId}`, c.userId.slice(0, 8) + "…") : "—",
              c.endpoint,
              c.model,
              c.status === "error" ? badge("error", "red") : badge("ok", "green"),
              `${fmtInt(c.inputTokens)} / ${fmtInt(c.outputTokens)}`,
              fmtCost(c.costUsd),
              `${fmtInt(c.latencyMs)} ms`,
            ]),
          ),
        );
      } catch {
        mount(totalsEl, badge("Failed to load LLM stats", "red"));
      }
    }

    windowSel.addEventListener("change", load);
    void load();
  }
</script>
