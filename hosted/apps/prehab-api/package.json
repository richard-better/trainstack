{
  "name": "@trainstack/prehab-api",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "with-env": "dotenv -e ../../.env.prehab --",
    "build": "bun run build.ts",
    "build:docker": "BUILD_TARGET=linux-x64 bun run build.ts",
    "check-types": "tsc -b",
    "dev": "bun run with-env bun run --hot src/index.ts",
    "dev:worker": "APP_MODE=worker bun run with-env bun run --hot src/index.ts",
    "start": "./dist/server",
    "test": "vitest run",
    "test:watch": "bun run with-env vitest",
    "db:push": "bun run with-env drizzle-kit push",
    "db:generate": "bun run with-env drizzle-kit generate",
    "db:studio": "bun run with-env drizzle-kit studio",
    "db:migrate": "bun run with-env drizzle-kit migrate",
    "db:seed": "bun run with-env bun run src/db/seed.ts",
    "db:reset": "bun run with-env bun run src/db/reset.ts",
    "db:backfill-session-source": "bun run with-env bun run src/db/backfill-session-source.ts",
    "test:smoke": "bun run with-env bun scripts/smoke.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/otel": "^0.18.1",
    "@fastify/rate-limit": "^10.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/instrumentation-pg": "^0.66.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@orpc/openapi": "catalog:",
    "@orpc/otel": "^1.13.14",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@trainstack/prehab-contract": "workspace:*",
    "@trainstack/prehab-email": "workspace:*",
    "@trainstack/prehab-env": "workspace:*",
    "ai": "^6.0.191",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.3.3",
    "graphile-worker": "^0.16.6",
    "pg": "^8.17.1",
    "pino": "^10.3.1",
    "resend": "^4.5.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@trainstack/prehab-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.16.5",
    "typescript": "catalog:",
    "vitest": "^3.0.0"
  }
}
