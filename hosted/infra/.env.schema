WEB_APP_ORIGIN=http://localhost:3001

# The domain this instance serves in the production stage: the website at the domain itself, the
# web app at account.<domain> and the API at api.<domain>. Its zone must be in the Cloudflare
# account the stack deploys to.
# @public @required @type=domain
TRAINSTACK_DOMAIN=trainstackhq.com
